# local with every cloud surface hidden. Values live in Supabase →
# Project Settings → API. The anon key is safe to expose in the client;
# row-level security (supabase/schema.sql) is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
